# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- Supabase (from your Supabase project's Settings > API page) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server-side only, never expose to the browser.
# Used by API routes that need to write across athletes (e.g., the corpus).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (from console.anthropic.com > API Keys) ---
# This is a SEPARATE account/billing from your claude.ai subscription.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Coach signup gate ---
# There's no invite system yet, so anyone who knows this code can create a
# coach account at /coach/signup. Make it up yourself (any string works) and
# keep it private. Required — coach signup is refused if this is unset.
COACH_SETUP_CODE=choose-a-private-setup-code

# --- Sentry (error monitoring) — optional, everything works without it ---
# Create a free project at sentry.io, then paste its DSN below (Settings >
# Client Keys (DSN)). Leaving these unset just means errors only show up in
# your own server/browser console, like before Sentry was wired in.
NEXT_PUBLIC_SENTRY_DSN=
# Same DSN, server-side — some Sentry project types split these; if yours
# only gives you one DSN, use that same value for both.
SENTRY_DSN=
# Only needed if you want Sentry to upload real (un-minified) source maps on
# build, so stack traces in the Sentry dashboard show your actual code
# instead of minified output. Find these under Settings > Auth Tokens (a
# token scoped to project:releases) and Settings > General (org/project
# slugs). Skip all three and error reporting still works — you'll just read
# minified stack traces.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Upstash Redis (shared rate limiting) — optional, but recommended once deployed ---
# Without this, the signup and AI-generation rate limiters fall back to an
# in-memory count that does NOT share state across Vercel's serverless
# instances, so the limits aren't reliably enforced in production (fine for
# local dev). Create a free database at upstash.com (Redis > Create Database
# — any region close to your Vercel deployment region works), then copy the
# REST URL and REST token from its dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron protection — optional, but recommended once deployed ---
# Secures /api/cron/phase-transitions (the daily automatic phase-transition/
# generation check, see vercel.json). Set this to any random string in
# Vercel's project settings and Vercel automatically sends it as a Bearer
# token on the scheduled request. Not needed for local dev — the cron only
# fires from Vercel's own scheduler, never from `npm run dev`.
CRON_SECRET=
