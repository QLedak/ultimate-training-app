# Copy to .env (same folder) and fill in. Only PUBLIC values go here.
# NEVER put the Supabase service-role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Your deployed web app (the backend the phone talks to), no trailing slash.
# While testing on your own Wi-Fi you can use http://<your PC's LAN IP>:3000
EXPO_PUBLIC_API_URL=https://your-app.vercel.app
